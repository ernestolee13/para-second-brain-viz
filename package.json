{
  "name": "para-second-brain-viz",
  "version": "0.2.4",
  "private": true,
  "description": "Obsidian visual analytics for existing PARA vault structure and privacy-safe query/build telemetry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ernestolee13/para-second-brain-viz.git"
  },
  "homepage": "https://github.com/ernestolee13/para-second-brain-viz",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs --production",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "package:release": "npm run check && node scripts/package-release.mjs",
    "version": "node version-bump.mjs",
    "audit:runtime": "npm audit --omit=dev"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "obsidian": "^1.12.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
